<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hmt_line" />
            <stroke android:width="2dp" android:color="@color/hmt_red" />
            <corners android:radius="36dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hmt_surface" />
            <stroke android:width="2dp" android:color="@color/hmt_line" />
            <corners android:radius="36dp" />
        </shape>
    </item>
</selector>
