<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HmtVocale" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/hmt_red</item>
        <item name="colorPrimaryDark">@color/hmt_black</item>
        <item name="colorAccent">@color/hmt_red</item>
        <item name="colorControlActivated">@color/hmt_red</item>
        <item name="android:windowBackground">@color/hmt_black</item>
        <item name="android:statusBarColor">@color/hmt_black</item>
        <item name="android:navigationBarColor">@color/hmt_black</item>
        <item name="android:textColorPrimary">@color/hmt_white</item>
        <item name="android:textColorSecondary">@color/hmt_grey</item>
        <item name="android:textColorHint">@color/hmt_grey</item>
    </style>

    <style name="Hmt.Title">
        <item name="android:textColor">@color/hmt_white</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Hmt.Section">
        <item name="android:textColor">@color/hmt_red</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="Hmt.Body">
        <item name="android:textColor">@color/hmt_white</item>
        <item name="android:textSize">18sp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="Hmt.Muted">
        <item name="android:textColor">@color/hmt_grey</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="Hmt.Button" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/hmt_white</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:paddingStart">32dp</item>
        <item name="android:paddingEnd">32dp</item>
    </style>

    <style name="Hmt.Button.Secondary">
        <item name="android:background">@drawable/bg_button_secondary</item>
    </style>

    <style name="Hmt.Choice" parent="Hmt.Button">
        <item name="android:background">@drawable/bg_choice</item>
    </style>

    <style name="Hmt.Switch">
        <item name="android:textColor">@color/hmt_white</item>
        <item name="android:textSize">18sp</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="Hmt.Input">
        <item name="android:textColor">@color/hmt_white</item>
        <item name="android:textSize">17sp</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>
